{
  "name": "shelly",
  "productName": "Shelly PDF",
  "version": "0.3.2",
  "description": "A desktop PDF reader & editor: view, search, organize pages, add text and images.",
  "author": "eddiekhaw <eddiekhaw@gmail.com>",
  "license": "MIT",
  "main": "electron/main.cjs",
  "scripts": {
    "build": "node scripts/copy-ocr-assets.mjs && vite build",
    "start": "npm run build && electron .",
    "test": "vitest run",
    "dist": "npm run build && electron-builder"
  },
  "dependencies": {
    "@tesseract.js-data/eng": "^1.0.0",
    "pdf-lib": "^1.17.1",
    "pdfjs-dist": "^5.0.0",
    "tesseract.js": "^7.0.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.52.0",
    "electron": "^36.0.0",
    "electron-builder": "^26.0.0",
    "vite": "^6.0.0",
    "vitest": "^3.0.0"
  },
  "build": {
    "appId": "com.shelly.pdf",
    "productName": "Shelly PDF",
    "files": [
      "dist/**",
      "electron/**",
      "package.json"
    ],
    "directories": {
      "output": "release"
    },
    "fileAssociations": [
      {
        "ext": "pdf",
        "name": "PDF Document",
        "description": "PDF Document",
        "role": "Viewer"
      }
    ],
    "linux": {
      "target": "AppImage",
      "category": "Office"
    },
    "mac": {
      "target": "dmg"
    },
    "win": {
      "target": "nsis"
    }
  }
}
