{
  "name": "shelly",
  "productName": "Shelly PDF",
  "version": "0.1.0",
  "description": "A desktop PDF reader & editor: view, search, organize pages, add text and images.",
  "author": "eddiekhaw <eddiekhaw@gmail.com>",
  "license": "MIT",
  "main": "electron/main.cjs",
  "scripts": {
    "build": "vite build",
    "start": "npm run build && electron .",
    "test": "vitest run",
    "dist": "npm run build && electron-builder"
  },
  "dependencies": {
    "pdf-lib": "^1.17.1",
    "pdfjs-dist": "^5.0.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.52.0",
    "electron": "^36.0.0",
    "electron-builder": "^26.0.0",
    "vite": "^6.0.0",
    "vitest": "^3.0.0"
  },
  "build": {
    "appId": "com.shelly.pdf",
    "productName": "Shelly PDF",
    "files": [
      "dist/**",
      "electron/**",
      "package.json"
    ],
    "directories": {
      "output": "release"
    },
    "linux": {
      "target": "AppImage",
      "category": "Office"
    },
    "mac": {
      "target": "dmg"
    },
    "win": {
      "target": "nsis"
    }
  }
}
